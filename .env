# ---- App ----
APP_NAME=gajab-affiliate
APP_HOST=localhost
APP_PORT=4000
APP_ROUTE_PREFIX=/api
APP_BANNER=true

# ---- Log ----
LOG_LEVEL=debug
LOG_JSON=false
LOG_OUTPUT=console

# ---- Database ----
TYPEORM_CONNECTION=postgres
TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=password
TYPEORM_DATABASE=gajab_affiliate
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false

# ---- Monitor ----
MONITOR_ENABLED=false
MONITOR_ROUTE=/monitor

# ---- Auth ----
JWT_SECRET=gajab-super-secret-change-me-in-prod

